# ==========================================
# LLM PROVIDER SELECTION
# ==========================================
# Choose which LLM backend generates the DMX lighting plans.
# Options: "azure" (default) or "bedrock"
LLM_PROVIDER="azure"

# ==========================================
# AZURE OPENAI CONFIGURATION
# ==========================================
# Required only if LLM_PROVIDER="azure" (the default).
# Get these from: https://portal.azure.com → Azure AI Services → Your Resource → Keys and Endpoint

AZURE_OPENAI_ENDPOINT="https://YOUR_RESOURCE_NAME.openai.azure.com"
AZURE_OPENAI_API_KEY="your-api-key-here"
AZURE_OPENAI_API_VERSION="2024-08-01-preview"

# The deployment name of your model in Azure AI Studio / Azure AI Foundry
# Recommended: GPT-4o-mini or GPT-5 Nano
AZURE_OPENAI_DEPLOYMENT_NAME="gpt-4o-mini"

# ==========================================
# AMAZON BEDROCK CONFIGURATION
# ==========================================
# Required only if LLM_PROVIDER="bedrock".
# AWS credentials — or leave blank to use IAM roles / ~/.aws/credentials.
# AWS_ACCESS_KEY_ID="your-access-key-here"
# AWS_SECRET_ACCESS_KEY="your-secret-key-here"
# AWS_DEFAULT_REGION="us-east-1"

# Bedrock model ID to use for lighting plan generation.
# Claude models (recommended):
#   anthropic.claude-sonnet-4-20250514-v1:0   (Claude 4 Sonnet — best quality)
#   anthropic.claude-3-5-sonnet-20241022-v2:0 (Claude 3.5 Sonnet — widely available)
#   anthropic.claude-3-haiku-20240307-v1:0    (fastest / cheapest)
# Amazon models:
#   amazon.nova-pro-v1:0
#   amazon.titan-text-express-v1
# BEDROCK_MODEL_ID="anthropic.claude-sonnet-4-20250514-v1:0"
